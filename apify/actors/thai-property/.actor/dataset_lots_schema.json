{
  "actorSpecification": 1,
  "fields": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "recordType": {
        "description": "Always \"lot\"."
      },
      "lotId": {
        "description": "ID of the lot: the smallest listing key in it."
      },
      "transaction": {
        "description": "sale or rent."
      },
      "project": {
        "description": "Project name."
      },
      "projectKey": {
        "description": "Project key; joins lots, projects and listings."
      },
      "district": {
        "description": "District."
      },
      "bedrooms": {
        "description": "Bedrooms."
      },
      "floor": {
        "description": "The unit's floor, from a listing's description; null when no listing names it."
      },
      "sizeSqm": {
        "description": "Size in m² (median of the listings)."
      },
      "listings": {
        "description": "Listings of this unit."
      },
      "advertisers": {
        "description": "Different advertisers among them, by the signature in the description (an estimate)."
      },
      "minPrice": {
        "description": "Lowest asking price of the unit, in THB."
      },
      "maxPrice": {
        "description": "Highest asking price, in THB."
      },
      "priceSpreadPercent": {
        "description": "How much the highest price is above the lowest, in percent."
      },
      "minPricePerSqm": {
        "description": "Lowest price per m², in THB."
      },
      "vsProjectMedianPercent": {
        "description": "The lowest price per m² against the project's typical asking price per m², in percent; below zero is cheaper."
      },
      "cheapestUrl": {
        "description": "Link to the cheapest listing of the unit."
      },
      "sharedPhotos": {
        "description": "Photos the listings share: the same file or nearly the same picture (marketing renders and common-area photos not counted)."
      },
      "offers": {
        "description": "Every listing of the unit: link, price, advertiser signature, posted date and days listed."
      },
      "scrapedAt": {
        "description": "When the record was saved."
      },
      "confidence": {
        "description": "high: two or more shared photos; medium: one, which can also be a render used by two listings of different units."
      }
    },
    "additionalProperties": true
  },
  "views": {
    "overview": {
      "title": "Units listed more than once",
      "transformation": {
        "fields": [
          "project",
          "district",
          "bedrooms",
          "floor",
          "sizeSqm",
          "listings",
          "minPrice",
          "maxPrice",
          "priceSpreadPercent",
          "vsProjectMedianPercent",
          "cheapestUrl",
          "confidence"
        ]
      },
      "display": {
        "component": "table",
        "properties": {
          "project": {
            "label": "Project",
            "format": "text"
          },
          "district": {
            "label": "District",
            "format": "text"
          },
          "bedrooms": {
            "label": "Beds",
            "format": "number"
          },
          "sizeSqm": {
            "label": "m²",
            "format": "number"
          },
          "listings": {
            "label": "Listings",
            "format": "number"
          },
          "minPrice": {
            "label": "Lowest ฿",
            "format": "number"
          },
          "maxPrice": {
            "label": "Highest ฿",
            "format": "number"
          },
          "priceSpreadPercent": {
            "label": "Spread %",
            "format": "number"
          },
          "vsProjectMedianPercent": {
            "label": "vs project %",
            "format": "number"
          },
          "cheapestUrl": {
            "label": "Cheapest",
            "format": "link"
          },
          "confidence": {
            "label": "Confidence",
            "format": "text"
          },
          "floor": {
            "label": "Floor",
            "format": "number"
          }
        }
      }
    }
  }
}
